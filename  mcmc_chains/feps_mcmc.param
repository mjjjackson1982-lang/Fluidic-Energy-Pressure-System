# ============================================================================
# FEPS 8-Parameter MCMC Sampler Configuration (MontePython / Cobaya Compatible)
# Fluidic Energy Pressure System (FEPS) - 4-Chain Parallel Convergence Setup
# ============================================================================

# --- Cosmological & FEPS Fluid Parameters [mean, min, max, sigma, scale, role] ---
data.parameters['omega_b']      = [ 2.2420,   None, None,  0.0150, 0.01, 'cosmo']
data.parameters['omega_cdm']    = [ 0.11933,  None, None,  0.0012, 1.0,  'cosmo']
data.parameters['H0']           = [ 73.040,   60.0, 85.0,  0.350,  1.0,  'cosmo']
data.parameters['ln10^{10}A_s'] = [ 3.0448,   None, None,  0.0140, 1.0,  'cosmo']
data.parameters['n_s']          = [ 0.9649,   None, None,  0.0042, 1.0,  'cosmo']
data.parameters['tau_reio']     = [ 0.0544,   0.01, None,  0.0073, 1.0,  'cosmo']

# --- FEPS Early Relativistic Fluid & Late-Time CPL Transition ---
data.parameters['N_ur']         = [ 3.52377,  2.50, 4.50,  0.0450, 1.0,  'cosmo']
data.parameters['w0_fld']       = [-1.1000,  -1.50,-0.50,  0.0320, 1.0,  'cosmo']

# --- Fixed / Derived Cosmological Settings ---
data.cosmo_arguments['wa_fld']       = -0.10
data.cosmo_arguments['Omega_Lambda'] = 0.0
data.cosmo_arguments['cs2_fld']      = 1.0
data.cosmo_arguments['N_ncdm']       = 0

# --- Derived Parameters Tracked Across Chains ---
data.parameters['r_d']          = [1, None, None, 0, 1, 'derived']
data.parameters['r_star']       = [1, None, None, 0, 1, 'derived']
data.parameters['S_8']          = [1, None, None, 0, 1, 'derived']

# --- Joint Observational Likelihoods ---
data.experiments = [
    'Planck_highl_TTTEEE',
    'Planck_lowl_EE',
    'Planck_lowl_TT',
    'Planck_lensing',
    'Pantheon_Plus_SH0ES',
    'DES_Y3_3x2pt'
]

# --- Parallel Chain & Convergence Settings ---
data.N_chains = 4
data.gelman_rubin_tolerance = 0.02
data.write_step = 50
